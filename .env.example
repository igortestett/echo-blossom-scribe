# URL pública do site (use seu domínio próprio em produção)
VITE_SITE_URL=https://dramatica.blog

# Domínio para o arquivo CNAME do GitHub Pages (sem https://)
# Ex.: dramatica.blog
CUSTOM_DOMAIN=dramatica.blog

# Google AdSense — preencha após criar sua conta e ser aprovado
# Formato: ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_CLIENT_ID=

# IDs dos blocos de anúncio (criados no painel do AdSense)
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_INLINE=
VITE_ADSENSE_SLOT_LARGE=
VITE_ADSENSE_SLOT_VERTICAL=

# Banco PostgreSQL (apenas desenvolvimento local — GitHub Pages usa dados estáticos)
# DATABASE_URL=postgresql://...
